# Mêmes exclusions que .gitignore, sauf google-services.json / GoogleService-Info.plist
# qui doivent être uploadés vers EAS Build (ils sont référencés par app.config.js
# mais ignorés par git car contiennent des clés spécifiques à l'environnement).

